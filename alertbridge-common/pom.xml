<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.alertbridge</groupId>
        <artifactId>alertbridge-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>alertbridge-common</artifactId>
    <name>alertbridge-common</name>
    <description>
        AlertBridge Common Library – plain Java library (NOT a Spring Boot application).
        Provides shared DTOs, enums, exceptions, and a reusable Spring MVC exception handler
        for all AlertBridge microservices. Compiled against bare Spring Framework and
        Jakarta APIs; does not pull in embedded servers or Boot auto-configuration.
    </description>

    <!--
        ┌─────────────────────────────────────────────────────────────────┐
        │  THIS MODULE IS A PLAIN JAR LIBRARY — NOT A SPRING BOOT APP    │
        │                                                                 │
        │  • No spring-boot-maven-plugin (no fat/executable jar)         │
        │  • No spring-boot-starter-* (no embedded Tomcat, no            │
        │    auto-configuration, no Boot context)                        │
        │  • All versions are managed by the parent Spring Boot BOM      │
        │    so consumers always get a consistent dependency set         │
        └─────────────────────────────────────────────────────────────────┘
    -->
    <dependencies>

        <!--
            Spring WebMVC – provides @RestControllerAdvice, @ExceptionHandler,
            ResponseEntity, HttpStatus, MethodArgumentNotValidException etc.
            This is a Spring Framework dependency, NOT a Spring Boot starter —
            it carries no embedded server or Boot auto-configuration.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>

        <!--
            Jakarta Servlet API – supplies HttpServletRequest used by
            GlobalExceptionHandler.  Provided because the actual
            implementation is supplied by the container (or embedded
            server) at runtime in each service.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Jakarta Validation API – only the annotation contract
            (@NotBlank, @NotNull, @Size …) used on NotificationRequest.
            No Hibernate Validator implementation is pulled in here;
            the consuming service brings its own validation runtime.
        -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!--
            Jackson Annotations – @JsonInclude on ApiResponse and
            ErrorResponse.  Only the annotations jar is needed for
            compilation; the full runtime (jackson-databind) is
            provided by whichever service uses this library.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!--
            SLF4J API – logging façade used in GlobalExceptionHandler.
            Consumers bind their own implementation (Logback, Log4j2 …).
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

    </dependencies>

</project>
